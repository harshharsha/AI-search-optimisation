DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aisoa"
OPENROUTER_API_KEY=""

# Login. Set a password to protect the app (required when running in production).
APP_PASSWORD=""
# Secret used to sign login cookies. Generate one with: openssl rand -hex 32
AUTH_SECRET=""

# Comma-separated OpenRouter model ids used by the seed
DEFAULT_MODELS="meta-llama/llama-3.3-70b-instruct:free"
# Cron for scheduled runs (default: daily 09:00)
RUN_SCHEDULE="0 9 * * *"
# Pause between model calls, to respect free-tier rate limits
RATE_LIMIT_MS="3500"

# Model used to write content briefs (default: the project's first model, without :online)
BRIEF_MODEL=""
